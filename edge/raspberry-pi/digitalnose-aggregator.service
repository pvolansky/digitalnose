[Unit]
Description=Digital Nose Phase I aggregator
After=local-fs.target time-sync.target

[Service]
Type=simple
User=diginose
SupplementaryGroups=i2c
WorkingDirectory=/home/diginose/digital-nose
EnvironmentFile=/etc/digitalnose.env
ExecStart=/home/diginose/digital-nose/phase1-current/.venv/bin/python -u /home/diginose/digital-nose/phase1-current/aggregator.py
Restart=always
RestartSec=5
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
